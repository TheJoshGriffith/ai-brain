# --- Database ---
# Postgres connection string. The Docker Compose service exposes pgvector-enabled Postgres on 5433.
DATABASE_URL=postgres://ai_brain:ai_brain@localhost:5433/ai_brain

# --- Auth (Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_URL=http://localhost:3002

# --- Embeddings ---
# Provider: "local" (default, in-process, no API key) | "voyage" | "openai"
EMBEDDING_PROVIDER=local
# Local model (transformers.js). 384-dim default keeps the pgvector column width in sync.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Only needed if EMBEDDING_PROVIDER is set to a hosted provider:
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- MCP server ---
MCP_HTTP_PORT=8787

# --- Background worker ---
# Days a document stays in Trash before the worker purges it permanently.
TRASH_RETENTION_DAYS=30

# --- Email (transactional: password reset, verification, invites) ---
# Leave SMTP_HOST blank in dev to log links to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI Brain <no-reply@ai-brain.local>
# Require users to verify their email before they can sign in.
REQUIRE_EMAIL_VERIFICATION=false
