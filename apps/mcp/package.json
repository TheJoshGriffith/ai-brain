{
  "name": "@ai-brain/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-brain-mcp": "src/stdio.ts"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/stdio.ts",
    "start:stdio": "node --import tsx src/stdio.ts",
    "start:http": "node --import tsx src/http.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-brain/core": "workspace:*",
    "@ai-brain/db": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "drizzle-orm": "^0.38.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
