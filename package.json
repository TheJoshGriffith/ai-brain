{
  "name": "ai-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Markdown knowledge base and AI brain",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ai-brain/db db:generate",
    "db:migrate": "pnpm --filter @ai-brain/db db:migrate",
    "db:push": "pnpm --filter @ai-brain/db db:push",
    "db:studio": "pnpm --filter @ai-brain/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
